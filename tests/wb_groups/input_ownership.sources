# InputOwnership deterministic host variant (plan wb079-unified-77f68967, Task 8 / C1 observation).
# The fixture links the REAL production input.cpp and the REAL imgui_impl_win32 backend on a real hidden HWND
# created by a window-owner thread; the fixture owns only the OS/native-hook seam (an in-process GetCursorPos
# patch with a substitute saved original, and a synthetic WM_INPUT handle whose GetRawInputData fails closed) and
# the core:: symbols input.cpp reads. No input-stub and no second router is compiled here: every case compares the
# production route trace with the messages the original window procedure and the real backend actually received.
# overlay.cpp is hashed as an evidence input (its routing section publishes the snapshot) but is not linked: it
# needs the DXGI binding, and the real input proof belongs to this suite.
@include tools/imgui
@include tools/imgui/backends
@include tools/minhook/include
asi/cdmodkit/input.cpp
# R2 repair: the IO-SETTINGS-LEGACY case compiles the production core TU read-only INTO the fixture TU
# (settings path only) and links its pure collaborators as production. overlay.cpp/http_api.cpp/thumbgen.cpp
# stay out (renderer/threads); their boundaries are record-free host substitutes in the fixture.
asi/cdmodkit/proj_codec.cpp
asi/cdmodkit/wb_group_math.cpp
asi/cdmodkit/i18n.cpp
tools/imgui/backends/imgui_impl_win32.cpp
# Current-main services are linked without replacing terrain persistence or native travel authority.
@define _CRT_SECURE_NO_WARNINGS
tests/wb_groups/production_research_host.cpp
tests/wb_groups/production_travel_host.cpp
tests/wb_groups/production_terrain_host.cpp
asi/cdmodkit/terrain_live.cpp
asi/cdmodkit/terrain_physics.cpp
asi/cdmodkit/terrain_research.cpp
asi/cdmodkit/gpu_research.cpp
@evidence asi/cdmodkit/terrain.cpp
@evidence asi/cdmodkit/travel.cpp
@evidence asi/cdmodkit/core_internal.h
@evidence tests/wb_groups/production_host.h
tools/imgui/imgui.cpp
tools/imgui/imgui_draw.cpp
tools/imgui/imgui_tables.cpp
tools/imgui/imgui_widgets.cpp
# @evidence entries are hashed into the run receipt and never passed to the compiler as sources.
@evidence asi/cdmodkit/input.h
@evidence asi/cdmodkit/overlay.cpp
@evidence asi/cdmodkit/core.h
@evidence asi/cdmodkit/cdmodkit.cpp
@evidence asi/cdmodkit/proj_codec.cpp
@evidence asi/cdmodkit/proj_codec.h
@evidence asi/cdmodkit/wb_group_math.cpp
@evidence asi/cdmodkit/wb_group_math.h
@evidence asi/cdmodkit/i18n.cpp
@evidence asi/cdmodkit/i18n.h
@evidence tools/imgui/backends/imgui_impl_win32.h
@evidence tests/wb_groups/input_ownership.sources
