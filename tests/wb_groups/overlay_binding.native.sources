# Native MinHook variant of the OverlayBinding suite: the fixture is compiled with WB_NATIVE_MINHOOK_SMOKE and
# linked against the real MinHook sources instead of its recording shim. Substituted are only the GPU regions
# (frame sink, drain, render-target rebuild); interception, discovery, capture, private-data attach and the
# read-only vtable observations run on real DXGI objects (system DXGI factory, WARP D3D12 DIRECT queue/swapchain, hidden HWND).
# overlay_discovery.cpp is linked as its own TU here as well; overlay.cpp is included by the fixture.
@define WB_NATIVE_MINHOOK_SMOKE
@include tools/imgui
@include tools/imgui/backends
@include tools/minhook/include
asi/cdmodkit/i18n.cpp
asi/cdmodkit/icons.cpp
asi/cdmodkit/overlay_discovery.cpp
tools/imgui/imgui.cpp
tools/imgui/imgui_draw.cpp
tools/imgui/imgui_tables.cpp
tools/imgui/imgui_widgets.cpp
tools/imgui/backends/imgui_impl_dx12.cpp
tools/imgui/backends/imgui_impl_win32.cpp
tools/minhook/src/buffer.c
tools/minhook/src/hook.c
tools/minhook/src/trampoline.c
tools/minhook/src/hde/hde64.c
# @evidence entries are hashed into the run receipt and are never passed to the compiler as sources.
@evidence asi/cdmodkit/overlay.cpp
@evidence asi/cdmodkit/overlay.h
@evidence asi/cdmodkit/input.h
@evidence asi/cdmodkit/input.cpp
@evidence asi/cdmodkit/guard.h
@evidence asi/cdmodkit/overlay_discovery.h
@evidence asi/cdmodkit/core.h
@evidence tests/wb_groups/overlay_binding.sources
@evidence tests/wb_groups/overlay_binding.native.sources
